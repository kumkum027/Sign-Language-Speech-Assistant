# Database Connection (Default SQLite for instant setup; or PostgreSQL connection string for Render/Supabase)
DATABASE_URL="file:./dev.db"

# Authentication & Security
JWT_SECRET="replace-with-a-secure-random-32-byte-hex-string"
NODE_ENV="production"

# Real-Time & Host URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"
SOCKET_PORT="3001"
